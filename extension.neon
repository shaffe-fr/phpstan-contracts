parameters:
	contracts:
		z3Binary: z3
		timeoutMs: 10000
		loopUnroll: 10
		maxLoopUnroll: 100
		cacheDirectory: %tmpDir%/contracts
		parallelism: null
		methodBudgetMs: 60000
		runBudgetMs: 0
		rememberUndecided: true
		costWarnings: false
		timingReport: null

parametersSchema:
	contracts: structure([
		z3Binary: string()
		timeoutMs: int()
		loopUnroll: int()
		maxLoopUnroll: int()
		cacheDirectory: schema(string(), nullable())
		parallelism: schema(int(), nullable())
		methodBudgetMs: int()
		runBudgetMs: int()
		rememberUndecided: bool()
		costWarnings: bool()
		timingReport: schema(string(), nullable())
	])

services:
	- PhpstanContracts\Contract\ContractReader
	- PhpstanContracts\Translate\ConstantGuard
	- PhpstanContracts\Translate\EnumRegistry
	- PhpstanContracts\Translate\TypeMapper
	- PhpstanContracts\Translate\DomainBuilder
	-
		class: PhpstanContracts\Translate\MethodEncoder
		arguments:
			loopUnroll: %contracts.loopUnroll%
			maxLoopUnroll: %contracts.maxLoopUnroll%
	- PhpstanContracts\Solver\ScriptRenderer
	- PhpstanContracts\Solver\SystemClock
	-
		class: PhpstanContracts\Solver\RunBudget
		arguments:
			limitMs: %contracts.runBudgetMs%
	- PhpstanContracts\Report\ValueFormatter
	- PhpstanContracts\Report\CounterexampleFormatter
	-
		class: PhpstanContracts\Report\TimingReport
		arguments:
			path: %contracts.timingReport%
	-
		class: PhpstanContracts\Solver\ProofCache
		arguments:
			directory: %contracts.cacheDirectory%
	-
		class: PhpstanContracts\Solver\Z3Runner
		arguments:
			binary: %contracts.z3Binary%
			timeoutMs: %contracts.timeoutMs%
			parallelism: %contracts.parallelism%
	-
		class: PhpstanContracts\Solver\MethodSolver
		arguments:
			methodBudgetMs: %contracts.methodBudgetMs%
			rememberUndecided: %contracts.rememberUndecided%
	-
		class: PhpstanContracts\Rule\VerifyContractRule
		arguments:
			timeoutMs: %contracts.timeoutMs%
			methodBudgetMs: %contracts.methodBudgetMs%
			loopUnroll: %contracts.loopUnroll%
			maxLoopUnroll: %contracts.maxLoopUnroll%
			costWarnings: %contracts.costWarnings%
			parallelism: %contracts.parallelism%
		tags:
			- phpstan.rules.rule
	-
		class: PhpstanContracts\Rule\PropertyHookContractRule
		tags:
			- phpstan.rules.rule
