parameters:
	contracts:
		z3Binary: z3
		timeoutMs: 10000
		loopUnroll: 10
		maxLoopUnroll: 100
		cacheDirectory: %tmpDir%/contracts

parametersSchema:
	contracts: structure([
		z3Binary: string()
		timeoutMs: int()
		loopUnroll: int()
		maxLoopUnroll: int()
		cacheDirectory: schema(string(), nullable())
	])

services:
	- PhpstanContracts\Contract\ContractReader
	- PhpstanContracts\Translate\ConstantGuard
	- PhpstanContracts\Translate\EnumRegistry
	- PhpstanContracts\Translate\TypeMapper
	- PhpstanContracts\Translate\DomainBuilder
	-
		class: PhpstanContracts\Translate\MethodEncoder
		arguments:
			loopUnroll: %contracts.loopUnroll%
			maxLoopUnroll: %contracts.maxLoopUnroll%
	- PhpstanContracts\Solver\ScriptRenderer
	- PhpstanContracts\Report\ValueFormatter
	- PhpstanContracts\Report\CounterexampleFormatter
	-
		class: PhpstanContracts\Solver\ProofCache
		arguments:
			directory: %contracts.cacheDirectory%
	-
		class: PhpstanContracts\Solver\Z3Runner
		arguments:
			binary: %contracts.z3Binary%
			timeoutMs: %contracts.timeoutMs%
	-
		class: PhpstanContracts\Rule\VerifyContractRule
		arguments:
			timeoutMs: %contracts.timeoutMs%
			loopUnroll: %contracts.loopUnroll%
			maxLoopUnroll: %contracts.maxLoopUnroll%
		tags:
			- phpstan.rules.rule
	-
		class: PhpstanContracts\Rule\PropertyHookContractRule
		tags:
			- phpstan.rules.rule
