includes:
	- {extension}
parameters:
	level: 0
	paths:
		- src
	scanDirectories:
		- lib
	tmpDir: tmp
	typeAliases:
		Ceiled: 'int<0, CacheProject\Ceiling::MAX>'
	parallel:
		jobSize: 1
		maximumNumberOfProcesses: 2
	bootstrapFiles:
		- {autoload}
		- bootstrap.php
	contracts:
		z3Binary: {z3}
		cacheDirectory: null
